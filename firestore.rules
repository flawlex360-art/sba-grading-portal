rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@school.com' ||
        callerProfile().isAdmin == true
      );
    }

    // Institutions (Multi-school registry & login portal selector)
    match /institutions/{instId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Teacher & Admin Accounts (includes JHS classAllocations)
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // School Class Documents (metadata, terms, students, grades, gradeMeta, rosterVersion)
    match /schools/{schoolId} {
      allow read: if true;
      // Class owners, allocated JHS subject teachers, and admins can write
      allow write: if isAuthenticated();
    }

    // Academic Year Rollover & Graduation Archives
    match /archives/{archiveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
